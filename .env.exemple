# Copier en .env et mettre un vrai mot de passe (par exemple : python -c "import secrets; print(secrets.token_hex(24))").
SPARTIATE_DB_PASSWORD=a-remplacer
# Facultatif : port local de l'API (127.0.0.1 seulement), essais autorisés par adresse
# SPARTIATE_API_PORT=8124
# FREIN_CONNEXION=10
# FREIN_INSCRIPTION=5
# Facultatif : port du jeu (conteneur jeu) et adresse à donner aux amis du même réseau
# SPARTIATE_PORT=8123
# SPARTIATE_URLS=http://192.168.1.20:8123
